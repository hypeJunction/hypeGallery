{
	"name": "hypejunction/hypegallery",
	"type": "elgg-plugin",
	"description": "Image galleries for Elgg",
	"homepage": "https://github.com/hypeJunction/hypegallery",
	"keywords": [
		"elgg", "plugin", "gallery", "images"
	],
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"extra": {
		"elgg-plugin": {
			"id": "hypegallery"
		}
	},
	"require": {
		"php": ">=8.3",
		"elgg/elgg": "~7.0.0",
		"composer/installers": "^2.0",
		"hypejunction/hypefilestore": "*",
		"ext-intl": "*"
	},
	"autoload": {
		"psr-4": {
			"hypeJunction\\": "classes/hypeJunction/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
